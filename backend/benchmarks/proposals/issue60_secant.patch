+"""Compare nonlinear TED constraints against exhaustive small build sets."""
+
+import os
+from itertools import product
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import numpy as np
+import pytest
+from sqlalchemy import create_engine
+from sqlalchemy.orm import Session
+
+os.environ.setdefault("IP_HASH_SECRET", "optimizer-ted-outer-test-secret")
+os.environ.setdefault("ADMIN_API_KEY", "optimizer-ted-outer-test-admin")
+
+from database import Base  # noqa: E402
+from models_items import Item  # noqa: E402
+from models_item_offers import ItemOffer  # noqa: E402
+from optimizer import local_price  # noqa: E402
+from optimizer.milp import (  # noqa: E402
+    TCHEBYCHEFF_Z_BOUND,
+    ConstraintBuilder,
+    _SolveStats,
+    _axis_objective_for_explore,
+    _build_constraints,
+    _solve_once,
+    _tchebycheff_model,
+)
+from optimizer.solver import OptimizeParams, _load_candidates_and_prices, optimize_weapon  # noqa: E402
+from optimizer.ted_outer import TedOuterConstraint  # noqa: E402
+from stats import _compute_stats, apply_full_mag_ammo  # noqa: E402
+from tests.test_reachability_integration import setup_graph  # noqa: E402
+
+
+@pytest.fixture
+def db():
+    engine = create_engine("sqlite://")
+    Base.metadata.create_all(engine)
+    with Session(engine) as session:
+        yield session
+    engine.dispose()
+
+
+def setup_choices(db, choices, *, base_ergo=40, base_weight=3, weapon_fields=None, extra_fields=None):
+    fields = {"gun": {"base_ergonomics": base_ergo, "weight": base_weight, **(weapon_fields or {})}}
+    for item_id, ergo, weight, recoil in choices:
+        fields[item_id] = {"ergonomics_modifier": ergo, "weight": weight, "recoil_modifier": recoil}
+    for item_id, values in (extra_fields or {}).items():
+        fields.setdefault(item_id, {}).update(values)
+    setup_graph(db, {("choice", "gun"): [choice[0] for choice in choices]}, required=["choice"], fields=fields)
+
+
+def assert_exhaustive_optimum(db, params, expected_item):
+    weapon, _, mods, (item_ids, prices) = _load_candidates_and_prices(db, "gun", params)
+    idx = {item_id: index for index, item_id in enumerate(item_ids)}
+    objective = _axis_objective_for_explore("recoil", item_ids, idx, mods, prices, len(item_ids))
+    ammo = db.get(Item, params.selected_ammo_id) if params.assume_full_mag and params.selected_ammo_id else None
+    grenade = (
+        db.get(Item, params.selected_ubgl_ammo_id) if params.assume_full_mag and params.selected_ubgl_ammo_id else None
+    )
+    feasible = []
+    for item_id in item_ids:
+        stats = _compute_stats(weapon, [item_id], mods, params.strength_level, params.equip_ergo_modifier)
+        apply_full_mag_ammo(
+            stats, {item_id: mods[item_id]}, ammo, grenade, params.strength_level, params.equip_ergo_modifier
+        )
+        if params.prevent_overswing and stats["overswing"]:
+            continue
+        if params.min_true_ergo_delta is not None and stats["true_ergo_delta"] < params.min_true_ergo_delta - 1e-7:
+            continue
+        feasible.append((objective[idx[item_id]], item_id, stats))
+
+    result = optimize_weapon(db, "gun", params, objective_axis="recoil")
+    if expected_item is None:
+        assert feasible == []
+        assert result["status"] == "infeasible"
+        assert result["selected_items"] == []
+        return result
+
+    expected = min(feasible, key=lambda candidate: candidate[:2])
+    assert expected[1] == expected_item
+    assert result["status"] == "optimal"
+    assert result["selected_items"] == [expected_item]
+    assert result["final_stats"] == expected[2]
+    assert result["total_price_rub"] == prices[expected_item]["price_rub"]
+    return result
+
+
+def tangent_choices(margin, equipment, *, fallback=True):
+    scale = 1 + equipment
+    choices = [("bad_first", 0, 2.1, -0.3), ("valid_better", 30 / scale, 6, -0.2)]
+    if fallback:
+        choices.append(("good_fallback", 0, 1.9, -0.1))
+    return choices, (40 + margin) / scale
+
+
+@pytest.mark.parametrize("margin", [-20, 0, 10, 20])
+@pytest.mark.parametrize("equipment", [-0.2, 0, 0.05])
+def test_ted_floor_preserves_the_true_optimum_after_rejecting_a_distant_build(db, margin, equipment):
+    choices, base_ergo = tangent_choices(margin, equipment)
+    setup_choices(db, choices, base_ergo=base_ergo)
+    params = OptimizeParams(use_tchebycheff=False, min_true_ergo_delta=margin, equip_ergo_modifier=equipment)
+    assert_exhaustive_optimum(db, params, "valid_better")
+
+
+@pytest.mark.parametrize("equipment", [-0.2, 0, 0.05])
+def test_overswing_constraint_preserves_the_true_optimum_after_rejecting_a_distant_build(db, equipment):
+    choices, base_ergo = tangent_choices(0, equipment)
+    setup_choices(db, choices, base_ergo=base_ergo)
+    params = OptimizeParams(use_tchebycheff=False, prevent_overswing=True, equip_ergo_modifier=equipment)
+    assert_exhaustive_optimum(db, params, "valid_better")
+
+
+@pytest.mark.parametrize(
+    "constraint", [{"prevent_overswing": True}, {"min_true_ergo_delta": 0}, {"min_true_ergo_delta": 10}]
+)
+def test_rejected_build_does_not_make_a_valid_build_falsely_infeasible(db, constraint):
+    choices, base_ergo = tangent_choices(constraint.get("min_true_ergo_delta", 0), 0, fallback=False)
+    setup_choices(db, choices, base_ergo=base_ergo)
+    assert_exhaustive_optimum(db, OptimizeParams(use_tchebycheff=False, **constraint), "valid_better")
+
+
+@pytest.mark.parametrize(
+    "constraint,expected",
+    [
+        ({"min_true_ergo_delta": 0}, "rounded_zero"),
+        ({"prevent_overswing": True}, "good_fallback"),
+        ({"min_true_ergo_delta": 0, "prevent_overswing": True}, "good_fallback"),
+    ],
+)
+def test_rounded_zero_ted_floor_and_strict_overswing_keep_their_own_boundaries(db, constraint, expected):
+    setup_choices(
+        db,
+        [("bad_first", 0, 3.1, -0.3), ("rounded_zero", 0, 3.0005, -0.2), ("good_fallback", 0, 2.9, -0.1)],
+        base_ergo=50,
