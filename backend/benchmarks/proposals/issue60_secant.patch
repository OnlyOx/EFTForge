+@pytest.mark.parametrize("constraint", [{"prevent_overswing": True}, {"min_true_ergo_delta": 10}])
+def test_factory_override_stats_can_make_an_affine_rejected_build_the_true_optimum(db, constraint):
+    margin = constraint.get("min_true_ergo_delta", 0)
+    setup_choices(
+        db,
+        [("bad_first", 0, 2.1, -0.3), ("valid_better", 0, 6, -0.2), ("good_fallback", 0, 1.9, -0.1)],
