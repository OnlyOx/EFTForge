+"""Preserve every feasible aiming build with lazy outer secant disjunctions."""
+
+import copy
+import math
+
+from stats import SWAY_START_KG
+
+TED_FLOOR_EPSILON = 1e-7
+_CUT_EPSILON = 1e-7
+_WEIGHT_RECIPROCAL = 100.0 * SWAY_START_KG
+_GRID_SEGMENTS = 16
+
+
+class TedOuterConstraint:
+    """Check exact stats and separate clearly invalid optimistic affine points."""
+
+    def __init__(self, solve_stats, cb, idx, min_true_ergo_delta=None, prevent_overswing=False):
+        self.solve_stats = solve_stats
+        self.cb = cb
+        self.idx = idx
+        self.min_true_ergo_delta = min_true_ergo_delta
+        self.prevent_overswing = prevent_overswing
+        self.cuts = []
+        self.grid = []
+        self.grid_bits = ()
+        self.cut_anchors = set()
+        self.linear_cut_anchors = set()
+        self.necessary_added = False
+        self.margin = None
+        if min_true_ergo_delta is not None:
+            if not math.isfinite(min_true_ergo_delta):
+                raise ValueError("TrueErgo floor must be finite")
+            # Permit every unrounded value whose exported two-decimal TED can pass.
+            rounded_floor = min_true_ergo_delta
+            if abs(rounded_floor) <= 101.0:
+                rounded_floor = math.ceil((rounded_floor - TED_FLOOR_EPSILON) * 100.0 - 1e-8) / 100.0
+            self.margin = rounded_floor - 0.005 - TED_FLOOR_EPSILON
+        if prevent_overswing:
+            self.margin = max(0.0, self.margin) if self.margin is not None else 0.0
+
+        self._prepare_affine_stats()
+        self.cb.ted_constraint = self
+
+    @property
+    def cut_count(self):
+        return len(self.grid) + len(self.cuts) + len(self.linear_cut_anchors)
+
+    def for_builder(self, cb):
+        model = copy.copy(self)
+        model.cb = cb
+        model.cuts = list(self.cuts)
+        model.grid = list(self.grid)
+        model.cut_anchors = set(self.cut_anchors)
+        model.linear_cut_anchors = set(self.linear_cut_anchors)
+        return model
+
+    def _prepare_affine_stats(self):
+        weapon, mods = self.solve_stats.weapon, self.solve_stats.mods
+        scale = 1.0 + self.solve_stats.equip_ergo_modifier
+        if not math.isfinite(scale) or scale < 0:
+            raise ValueError("Equipment ergonomics scale must be finite and nonnegative")
+        base_ergo = getattr(weapon, "base_ergonomics", None) or 0.0
+        base_weight = getattr(weapon, "weight", None) or 0.0
+        self.ergo_constant = base_ergo
+        self.weight_constant = base_weight
+        self.ergo_coefficients = {self.idx[i]: getattr(mods[i], "ergonomics_modifier", None) or 0.0 for i in self.idx}
+        self.weight_coefficients = {self.idx[i]: self.solve_stats.item_weights[i] for i in self.idx}
+
+        factory_ids = set(filter(None, (getattr(weapon, "factory_attachment_ids", None) or "").split(",")))
+        if factory_ids and factory_ids <= self.idx.keys():
+            factory_ergo = getattr(weapon, "factory_ergonomics", None) or base_ergo
+            factory_weight = getattr(weapon, "factory_weight", None) or base_weight
+            factory_ergo_sum = math.fsum(getattr(mods[i], "ergonomics_modifier", None) or 0.0 for i in factory_ids)
+            factory_weight_sum = math.fsum(getattr(mods[i], "weight", None) or 0.0 for i in factory_ids)
+            # Overestimate ergo and underestimate weight for either preset state.
+            self.ergo_constant += max(0.0, factory_ergo - base_ergo - factory_ergo_sum)
+            self.weight_constant += min(0.0, factory_weight - base_weight - factory_weight_sum)
+
+        ammo = getattr(self.solve_stats, "ammo", None)
+        grenade = getattr(self.solve_stats, "ubgl_grenade", None)
+        has_ammo = ammo is not None and getattr(ammo, "is_ammo", False)
+        has_grenade = (
+            grenade is not None
+            and getattr(grenade, "is_ammo", False)
+            and bool(getattr(grenade, "caliber", None))
+            and bool(getattr(grenade, "weight", None))
+        )
+        grenade_items = {
+            i
+            for i in self.idx
+            if has_grenade
+            and getattr(mods[i], "caliber", None) == grenade.caliber
+            and not getattr(mods[i], "is_ammo", False)
+        }
+        if has_ammo or grenade_items:
+            # Cover the rounded base and every subsequent loaded-weight round.
+            self.ergo_constant += 0.005
+            self.weight_constant -= 0.0005
+            for i, column in self.idx.items():
+                if has_ammo and getattr(mods[i], "magazine_capacity", None):
+                    self.weight_coefficients[column] -= 0.0005
+                if i in grenade_items:
+                    self.weight_coefficients[column] -= 0.0005
+
+        self.ergo_constant *= scale
+        self.ergo_coefficients = {column: scale * coefficient for column, coefficient in self.ergo_coefficients.items()}
+        values = [
+            self.ergo_constant,
+            self.weight_constant,
+            *self.ergo_coefficients.values(),
+            *self.weight_coefficients.values(),
+        ]
+        if not all(math.isfinite(value) for value in values):
+            raise ValueError("Aiming constraint coefficients must be finite")
+        self.weight_upper_bound = self.weight_constant + math.fsum(
+            max(0.0, value) for value in self.weight_coefficients.values()
+        )
+        if not math.isfinite(self.weight_upper_bound):
+            raise ValueError("Aiming constraint weight bound must be finite")
+        if self.margin is not None and self.margin > 0:
+            self.weight_upper_bound = min(self.weight_upper_bound, _WEIGHT_RECIPROCAL / self.margin)
+
+    def accepts_stats(self, stats):
+        if self.prevent_overswing and stats["overswing"]:
+            return False
+        return (
+            self.min_true_ergo_delta is None or stats["true_ergo_delta"] >= self.min_true_ergo_delta - TED_FLOOR_EPSILON
+        )
+
+    def _point(self, selected):
+        columns = [self.idx[i] for i in selected]
+        ergo = self.ergo_constant + math.fsum(self.ergo_coefficients[column] for column in columns)
+        weight = self.weight_constant + math.fsum(self.weight_coefficients[column] for column in columns)
+        return ergo, weight
+
+    def _add_necessary_rows(self):
+        if self.necessary_added or self.margin is None:
+            return False
+        self.necessary_added = True
+        if self.margin > 100.0:
+            self.cb.ge({}, 1.0)
+        else:
+            # Reuse the existing nonnegative raw-ergo model instead of adding a clamp.
+            self.cb.ge(self.ergo_coefficients, self.margin - self.ergo_constant)
+            if self.margin > 0:
+                self.cb.le(self.weight_coefficients, _WEIGHT_RECIPROCAL / self.margin - self.weight_constant)
+            if self.weight_upper_bound > SWAY_START_KG:
+                slope = 100.0 / self.weight_upper_bound
+                intercept = self.margin - _WEIGHT_RECIPROCAL / self.weight_upper_bound
+                coefficients, rhs, _big_m = self._row(slope, intercept)
+                # Keep the endpoint chord active even while every segment code is relaxed.
+                self.cb.ge(coefficients, rhs)
+        return True
+
+    def _row(self, slope, intercept):
+        coefficients = {
+            column: self.ergo_coefficients[column] - slope * self.weight_coefficients[column]
+            for column in self.idx.values()
+        }
+        constant = self.ergo_constant - slope * self.weight_constant
+        rhs = intercept - constant
+        # Bound each complete row over the binary cube to deactivate its branch safely.
+        minimum = math.fsum(min(0.0, value) for value in coefficients.values())
+        big_m = max(0.0, rhs - minimum)
+        if self.necessary_added and self.margin is not None:
+            # Reuse the necessary ergo floor and finite weight cap to tighten each branch.
+            bounded_m = max(0.0, intercept - self.margin + slope * self.weight_upper_bound)
+            big_m = min(big_m, bounded_m)
+        big_m += 1e-9 * max(1.0, abs(big_m))
+        return coefficients, rhs, big_m
+
+    def _add_grid(self, anchor):
+        lower = 1.0 / math.sqrt(SWAY_START_KG)
+        upper = 1.0 / math.sqrt(self.weight_upper_bound)
+        points = [1.0 / (lower + (upper - lower) * i / _GRID_SEGMENTS) ** 2 for i in range(_GRID_SEGMENTS + 1)]
+        points[0], points[-1] = SWAY_START_KG, self.weight_upper_bound
+        if SWAY_START_KG < anchor < self.weight_upper_bound and all(abs(point - anchor) > 1e-10 for point in points):
+            points.append(anchor)
+            points.sort()
+        self.grid_bits = tuple(self.cb.add_binary() for _ in range((len(points) - 2).bit_length()))
+        for code, (a, b) in enumerate(zip(points, points[1:])):
+            slope = _WEIGHT_RECIPROCAL / (a * b)
+            intercept = self.margin + 100.0 - _WEIGHT_RECIPROCAL / a - _WEIGHT_RECIPROCAL / b
+            coefficients, rhs, big_m = self._row(slope, intercept)
+            for position, bit in enumerate(self.grid_bits):
+                coefficients[bit] = -big_m if code & (1 << position) else big_m
+            self.cb.ge(coefficients, rhs - big_m * code.bit_count())
+            self.grid.append((code, slope, intercept))
+        # Encode the chosen segment in bits and deactivate every other row by Hamming distance.
+        if len(self.grid) < 1 << len(self.grid_bits):
+            self.cb.le({bit: 1 << position for position, bit in enumerate(self.grid_bits)}, len(self.grid) - 1)
+
+    def add_cut(self, selected):
+        if self.margin is None:
+            return False
+        necessary_added = self._add_necessary_rows()
+        ergo, weight = self._point(selected)
+        if self.margin > 100.0 or ergo < self.margin - _CUT_EPSILON:
+            return necessary_added
+        if self.margin > 0 and weight > _WEIGHT_RECIPROCAL / self.margin + _CUT_EPSILON:
+            return necessary_added
+        upper = self.weight_upper_bound
+        if weight <= SWAY_START_KG or upper <= SWAY_START_KG:
+            return False
+        endpoint_ergo = self.margin + 100.0 * (weight - SWAY_START_KG) / upper
+        if necessary_added and ergo < endpoint_ergo - _CUT_EPSILON:
+            return True
+        required_ergo = self.margin + 100.0 - _WEIGHT_RECIPROCAL / weight
+        if ergo >= required_ergo - _CUT_EPSILON:
+            # Fall back to an exact no-good when optimistic rounding already passes.
+            return False
+
+        if not self.grid and self.margin <= 0.0:
+            self._add_grid(weight)
+            if ergo < min(slope * weight + intercept for _code, slope, intercept in self.grid) - _CUT_EPSILON:
+                return True
+
+        anchor = min(weight, upper)
+        if anchor >= upper - 1e-10:
+            anchor = upper
+        left_slope = 100.0 / anchor
+        left_intercept = self.margin - left_slope * SWAY_START_KG
+        if anchor >= upper - 1e-10:
+            if anchor in self.linear_cut_anchors:
+                return False
+            # Use the single endpoint chord when the right segment has no width.
+            coefficients, rhs, _big_m = self._row(left_slope, left_intercept)
+            self.cb.ge(coefficients, rhs)
+            self.linear_cut_anchors.add(anchor)
+            return True
+
+        right_slope = _WEIGHT_RECIPROCAL / (anchor * upper)
+        right_intercept = self.margin + 100.0 - _WEIGHT_RECIPROCAL / anchor - _WEIGHT_RECIPROCAL / upper
+        if anchor in self.cut_anchors:
+            return False
+        binary = self.cb.add_binary()
+        coefficients, rhs, big_m = self._row(left_slope, left_intercept)
+        coefficients[binary] = big_m
+        self.cb.ge(coefficients, rhs)
+        coefficients, rhs, big_m = self._row(right_slope, right_intercept)
+        coefficients[binary] = -big_m
+        self.cb.ge(coefficients, rhs - big_m)
+        # Permit either chord; their minimum stays below the exact concave boundary.
+        self.cuts.append((binary, left_slope, left_intercept, right_slope, right_intercept))
+        self.cut_anchors.add(anchor)
+        return True
+
+    def fill_assignment(self, assignment):
+        ergo = self.ergo_constant + math.fsum(
+            value * assignment[column] for column, value in self.ergo_coefficients.items()
+        )
+        weight = self.weight_constant + math.fsum(
+            value * assignment[column] for column, value in self.weight_coefficients.items()
+        )
+        if self.grid:
+            chosen = min(self.grid, key=lambda segment: segment[1] * weight + segment[2])
+            for position, bit in enumerate(self.grid_bits):
+                assignment[bit] = float(bool(chosen[0] & (1 << position)))
+            if ergo < chosen[1] * weight + chosen[2] - _CUT_EPSILON:
+                return False
+        for binary, left_slope, left_intercept, right_slope, right_intercept in self.cuts:
+            if ergo >= left_slope * weight + left_intercept - _CUT_EPSILON:
+                assignment[binary] = 0.0
+            elif ergo >= right_slope * weight + right_intercept - _CUT_EPSILON:
+                assignment[binary] = 1.0
+            else:
+                return False
+        return True
