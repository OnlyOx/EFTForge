+@pytest.mark.parametrize("ergo,weight", [(99.5, 400), (100, 1000)])
+@pytest.mark.parametrize("constraint", [{"prevent_overswing": True}, {"min_true_ergo_delta": 0}])
+def test_high_effective_ergo_uses_the_exact_hundred_point_cap(db, ergo, weight, constraint):
