+@pytest.mark.parametrize("replacement_weight,expected", [(3.003, "expensive"), (2.9, "cheap")])
+def test_price_cleanup_respects_exact_ted_after_a_cut(db, monkeypatch, replacement_weight, expected):
+    setup_choices(
+        db,
+        [("bad_first", 0, 3.2, -0.1), ("expensive", 0, 2.9, -0.2), ("cheap", 0.01, replacement_weight, -0.2)],
+        base_ergo=60,
+    )
+    db.query(ItemOffer).filter_by(item_id="expensive").update({"price": 10000, "price_rub": 10000})
+    db.commit()
+    params = OptimizeParams(use_tchebycheff=False, min_true_ergo_delta=10)
+    weapon, compat, mods, (ids, prices) = _load_candidates_and_prices(db, "gun", params)
+    solve_stats = _SolveStats(weapon, mods, params)
+    ids, idx, cb, slots, *_ = _build_constraints(weapon, mods, compat, ids, prices, params, solve_stats)
+    constraint = TedOuterConstraint(solve_stats, cb, idx, min_true_ergo_delta=10)
+    assert constraint.add_cut({"bad_first"})
+    assert cb.binary_columns
+    assignment = np.zeros(cb.n)
+    assignment[idx["cheap"]] = 1
+    assignment[len(ids)] = weapon.base_ergonomics + mods["cheap"].ergonomics_modifier
+    assert constraint.fill_assignment(assignment)
+    rows = cb.build()
+    lhs = rows.A @ assignment
+    assert np.all(lhs >= rows.lb - 1e-7)
+    assert np.all(lhs <= rows.ub + 1e-7)
+    assert constraint.accepts_stats(solve_stats.compute(["cheap"])) == (expected == "cheap")
+    source = {"status": "optimal", "selected_items": ["expensive"], "total_price_rub": 10000, "metrics": {}}
+    monkeypatch.setattr(local_price.time, "perf_counter", lambda: 0)
+    result = local_price.improve_price(source, weapon, mods, compat, slots, ids, idx, prices, cb, solve_stats, 1)
+    assert result["selected_items"] == [expected]
+    assert constraint.accepts_stats(solve_stats.compute(result["selected_items"]))
+    assert result["metrics"]["local_price_saved_rub"] == (9900 if expected == "cheap" else 0)
+
