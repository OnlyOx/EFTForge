+@pytest.mark.parametrize("cent_floor", [-12.34, 0, 42.52, 100])
+@pytest.mark.parametrize("floor_offset", [-2e-7, 0, 0.5e-7, 1e-7, 2e-7])
+def test_snapped_model_margin_preserves_every_accepted_exported_cent(cent_floor, floor_offset):
+    floor = cent_floor + floor_offset
+    inputs = SimpleNamespace(
+        weapon=SimpleNamespace(base_ergonomics=0, weight=0), mods={}, item_weights={}, equip_ergo_modifier=0
+    )
+    constraint = TedOuterConstraint(inputs, ConstraintBuilder(1), {}, min_true_ergo_delta=floor)
+    cents = [round(cent_floor + offset / 100, 2) for offset in range(-2, 3)]
+    lowest_accepted_cent = min(value for value in cents if value >= floor - 1e-7)
+    assert constraint.margin == pytest.approx(lowest_accepted_cent - 0.005 - 1e-7, abs=1e-10)
+    for cent in cents:
+        for offset in [-1e-6, -1e-9, 0, 1e-9, 1e-6]:
+            raw_ted = cent - 0.005 + offset
+            exported = {"true_ergo_delta": round(raw_ted, 2)}
+            if constraint.accepts_stats(exported):
+                assert raw_ted >= constraint.margin - 1e-12
