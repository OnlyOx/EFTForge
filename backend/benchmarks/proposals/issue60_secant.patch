+def test_positive_ted_floor_accepts_a_build_that_clears_the_floor_after_rounding(db):
+    setup_choices(
+        db,
+        [("bad_first", 0, 2.1, -0.3), ("rounded_floor", 0, 2.0002, -0.2), ("good_fallback", 0, 1.9, -0.1)],
