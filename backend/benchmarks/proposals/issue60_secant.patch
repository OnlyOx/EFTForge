+def test_tchebycheff_z_keeps_its_own_bound_between_appended_cut_binaries():
+    cb = ConstraintBuilder(2)
+    first_binary = cb.add_binary()
+    ideal = {"ergo": 50, "recoil": -0.5, "price": 0}
+    nadir = {"ergo": 0, "recoil": 0, "price": 100}
+    objective, cb = _tchebycheff_model(
+        cb,
+        1,
+        ["mod"],
+        {"mod": 0},
+        {"mod": SimpleNamespace(recoil_modifier=0)},
+        {"mod": {"price_rub": 100}},
+        ideal,
+        nadir,
+        OptimizeParams(),
+    )
+    z_column = cb.n - 1
+    last_binary = cb.add_binary()
+    vector = np.array([1, 50, 1, 123.5, 0])
+    native = SimpleNamespace(status=0, x=vector, message="optimal")
+    with patch("optimizer.milp.milp", return_value=native) as solve:
+        result = _solve_once(
+            objective,
+            cb,
+            1,
+            ["mod"],
+            "weapon",
+            {"mod": [("slot", "weapon")]},
+            {"mod": {"price_rub": 100}},
+            extra_bounds=(100, TCHEBYCHEFF_Z_BOUND),
+        )
+    assert result["status"] == "optimal"
+    bounds = solve.call_args.kwargs["bounds"]
+    assert bounds.ub[z_column] == TCHEBYCHEFF_Z_BOUND
+    assert bounds.ub[first_binary] == bounds.ub[last_binary] == 1
+    np.testing.assert_array_equal(solve.call_args.kwargs["integrality"], [1, 0, 1, 0, 1])
