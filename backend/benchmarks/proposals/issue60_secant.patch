+@pytest.mark.parametrize("equipment", [-0.2, 0.05])
+@pytest.mark.parametrize("factory", [False, True])
+@pytest.mark.parametrize("loaded", [False, True])
+@pytest.mark.parametrize(
+    "constraint_options",
+    [{"min_true_ergo_delta": -20}, {"prevent_overswing": True}, {"min_true_ergo_delta": 10, "prevent_overswing": True}],
+)
+def test_every_valid_binary_selection_survives_all_rejected_selection_cuts(
+    db, equipment, factory, loaded, constraint_options
+):
+    fields = {
+        "gun": {"base_ergonomics": 35.0049, "weight": 3.20049},
+        "factory_a": {"ergonomics_modifier": 10.0051, "weight": 1},
+        "factory_b": {"ergonomics_modifier": 20.0049, "weight": 1},
+        "magazine": {"ergonomics_modifier": -15.0049, "weight": 0.20049, "magazine_capacity": 17},
+        "grenade_launcher": {"ergonomics_modifier": 4.9951, "weight": 0.50049, "caliber": "Caliber40x46"},
+        "heavy": {"ergonomics_modifier": 25.0051, "weight": 7.50049},
+        "ammo": {"is_ammo": True, "weight": 0.01377},
+        "grenade": {"is_ammo": True, "weight": 0.23049, "caliber": "Caliber40x46"},
+    }
+    if factory:
+        fields["gun"].update(
+            factory_attachment_ids="factory_a,factory_b", factory_ergonomics=75.0049, factory_weight=4.79949
+        )
+    choices = [item_id for item_id in fields if item_id not in {"gun", "ammo", "grenade"}]
+    setup_graph(db, {(item_id + "_slot", "gun"): [item_id] for item_id in choices}, fields=fields)
+    params = OptimizeParams(equip_ergo_modifier=equipment, **constraint_options)
+    weapon, compat, mods, (ids, prices) = _load_candidates_and_prices(db, "gun", params)
+    stats = _SolveStats(
+        weapon, mods, params, db.get(Item, "ammo") if loaded else None, db.get(Item, "grenade") if loaded else None
+    )
+    ids, idx, cb, *_ = _build_constraints(weapon, mods, compat, ids, prices, params, stats)
+    constraint = TedOuterConstraint(stats, cb, idx, **constraint_options)
+    valid, invalid = [], []
+    for bits in product([0, 1], repeat=len(ids)):
+        selected = {item_id for item_id, chosen in zip(ids, bits) if chosen}
+        exact = stats.compute(selected)
+        accepted = not params.prevent_overswing or not exact["overswing"]
+        accepted &= params.min_true_ergo_delta is None or exact["true_ergo_delta"] >= params.min_true_ergo_delta - 1e-7
+        (valid if accepted else invalid).append(selected)
+    assert valid and invalid
+    for selected in invalid:
+        if not constraint.add_cut(selected):
+            cb.ge({idx[item_id]: -1 if item_id in selected else 1 for item_id in ids}, 1 - len(selected))
+    rows = cb.build()
+    for selected in valid:
+        assignment = np.zeros(cb.n)
+        assignment[[idx[item_id] for item_id in selected]] = 1
+        assignment[len(ids)] = min(
+            100, weapon.base_ergonomics + sum(mods[item_id].ergonomics_modifier or 0 for item_id in selected)
+        )
+        assert constraint.fill_assignment(assignment), selected
+        lhs = rows.A @ assignment
+        assert np.all(lhs >= rows.lb - 1e-7), selected
+        assert np.all(lhs <= rows.ub + 1e-7), selected
+
